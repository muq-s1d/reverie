NEXT_PUBLIC_APP_PLATFORM=tauri

DBUS_ID=com.bilingify.readest

# Reverie: fully offline desktop app (src/reverie/offline.ts)
NEXT_PUBLIC_REVERIE_OFFLINE=true
# No update checks (they call GitHub/readest.com)
NEXT_PUBLIC_DISABLE_UPDATER=true
# No store to buy from: unlock Readest's premium customization, no upgrade prompts
NEXT_PUBLIC_SELF_HOSTED=true
